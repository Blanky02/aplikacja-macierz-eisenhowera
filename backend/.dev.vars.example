# Copy to backend/.dev.vars for local Salt Edge sandbox testing.
# Never commit the real values.
SALT_EDGE_APP_ID=""
SALT_EDGE_SECRET=""
AUTH_JWT_SECRET="local-only-change-me"
GOOGLE_WEB_CLIENT_ID=""
PUBLIC_BASE_URL="http://localhost:8787"
EMAIL_APP_REDIRECT_URI="fokus://auth/email"
